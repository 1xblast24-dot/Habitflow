<!DOCTYPE html>
<html lang="en"><head><meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>HabitFlow</title>
<style>
:root{--bg:#f7f7fa;--surf:#fff;--text:#0d0e14;--mute:#6c7080;--line:#ebebf1;--acc:#5b5bf0;--acc2:#14c8a8;--warn:#f5a623;--bad:#ef4565;--rest:#efeff5;--sh:0 1px 2px rgba(20,20,40,.04),0 8px 24px rgba(20,20,40,.06);box-sizing:border-box;padding-top:env(safe-area-inset-top,0px);padding-bottom:env(safe-area-inset-bottom,0px)}
@media (prefers-color-scheme:dark){:root:not([data-theme="light"]){--bg:#09090e;--surf:#14141c;--text:#f5f5fa;--mute:#8a8ea0;--line:#23232f;--acc:#8c8cff;--rest:#1d1d28;--sh:0 0 0 transparent}}
:root[data-theme="dark"]{--bg:#09090e;--surf:#14141c;--text:#f5f5fa;--mute:#8a8ea0;--line:#23232f;--acc:#8c8cff;--rest:#1d1d28;--sh:0 0 0 transparent}
*{box-sizing:border-box;-webkit-tap-highlight-color:transparent}
html{scroll-padding-top:env(safe-area-inset-top,0px)}
body{margin:0;background:var(--bg);color:var(--text);font:16px/1.4 "Inter",-apple-system,BlinkMacSystemFont,"SF Pro Display","Segoe UI",system-ui,sans-serif;-webkit-font-smoothing:antialiased}
main{max-width:560px;margin:0 auto;padding:22px 18px 130px}
h1{font-size:34px;font-weight:800;margin:2px 0;letter-spacing:-1px}
h2{font-size:12px;text-transform:uppercase;letter-spacing:.1em;color:var(--mute);margin:28px 0 12px;font-weight:700}
.mute{color:var(--mute);font-size:14px}.row{display:flex;align-items:center;gap:12px}.sp{flex:1}
.card{background:var(--surf);border-radius:24px;padding:4px 16px;box-shadow:var(--sh);border:1px solid var(--line)}
.item{display:flex;align-items:center;gap:14px;padding:13px 0;border-bottom:1px solid var(--line);min-height:72px}.item:last-child{border-bottom:0}
.item .sp>div:first-child{font-weight:600}
.ic{width:46px;height:46px;border-radius:15px;display:grid;place-items:center;font-size:22px;flex:none}
.chk{width:46px;height:46px;border-radius:50%;border:2px solid var(--line);background:var(--surf);color:#fff;font-size:20px;font-weight:700;flex:none;cursor:pointer;transition:transform .15s,background .2s}
.chk:active{transform:scale(.88)}.chk.COMPLETED{background:var(--c);border-color:var(--c);animation:pop .3s}.chk.PARTIAL{border-color:var(--c);color:var(--c)}.chk.SKIPPED{color:var(--mute);border-style:dashed}
@keyframes pop{50%{transform:scale(1.14)}}
button{font:inherit;color:inherit;cursor:pointer}
.btn{border:0;border-radius:16px;padding:13px 20px;background:var(--text);color:var(--bg);font-weight:700;min-height:46px}
.btn.g{background:var(--rest);color:var(--text)}.btn.d{background:none;color:var(--bad);border:1px solid var(--line)}
.step{width:40px;height:40px;border-radius:50%;border:0;background:var(--rest);font-size:20px;font-weight:600}
.val{min-width:78px;text-align:center;border:0;background:none;font-weight:700;padding:8px 2px;font-variant-numeric:tabular-nums}
.bar{height:8px;border-radius:9px;background:var(--rest);overflow:hidden}.bar i{display:block;height:100%;background:linear-gradient(90deg,var(--acc2),var(--acc));border-radius:9px;transition:width .4s}
.dock{position:fixed;left:16px;right:16px;bottom:calc(env(safe-area-inset-bottom,0px) + 12px);max-width:400px;margin:0 auto;display:flex;padding:6px;border-radius:999px;background:color-mix(in srgb,var(--surf) 72%,transparent);-webkit-backdrop-filter:blur(22px) saturate(180%);backdrop-filter:blur(22px) saturate(180%);border:1px solid color-mix(in srgb,var(--text) 8%,transparent);box-shadow:0 10px 36px rgba(20,20,50,.18);z-index:5}
.dock button{flex:1;border:0;background:none;border-radius:999px;min-height:54px;display:flex;flex-direction:column;align-items:center;justify-content:center;font-size:10px;font-weight:600;color:var(--mute);gap:3px;transition:background .25s,color .25s}
.dock svg{width:22px;height:22px;fill:none;stroke:currentColor;stroke-width:1.9;stroke-linecap:round;stroke-linejoin:round}
.dock button[aria-current="page"]{background:color-mix(in srgb,var(--acc) 15%,transparent);color:var(--acc)}
.pill{padding:8px 15px;border-radius:99px;border:0;background:var(--rest);font-size:14px;font-weight:600;min-height:38px;white-space:nowrap}.pill.on{background:var(--text);color:var(--bg)}
.seg{display:flex;gap:8px;overflow-x:auto;padding:2px 0}
.sheet{position:fixed;inset:0;background:rgba(5,5,15,.5);-webkit-backdrop-filter:blur(4px);backdrop-filter:blur(4px);display:flex;align-items:flex-end;justify-content:center;z-index:10}
.sheet>div{background:var(--bg);width:100%;max-width:560px;max-height:92%;overflow:auto;border-radius:30px 30px 0 0;padding:12px 20px calc(26px + env(safe-area-inset-bottom,0px));animation:up .28s ease-out}
.sheet>div::before{content:"";display:block;width:40px;height:5px;border-radius:9px;background:var(--line);margin:0 auto 16px}
@keyframes up{from{transform:translateY(40px);opacity:0}}
label{display:block;font-size:12px;font-weight:700;letter-spacing:.04em;text-transform:uppercase;color:var(--mute);margin:16px 0 7px}
input,select,textarea{width:100%;font:inherit;color:var(--text);background:var(--surf);border:1.5px solid var(--line);border-radius:14px;padding:12px 14px;min-height:46px;outline:0}
input:focus,select:focus,textarea:focus{border-color:var(--acc)}
.wd{display:flex;gap:6px}.wd button{flex:1;height:42px;border-radius:50%;border:0;background:var(--rest);font-weight:700}.wd button.on{background:var(--acc);color:#fff}
.grid{display:grid;grid-template-columns:repeat(7,1fr);gap:6px;text-align:center}
.cd{aspect-ratio:1;border-radius:50%;border:2px solid transparent;background:var(--surf);display:grid;place-items:center;font-size:14px;font-weight:600;position:relative;padding:0}
.cd.sel{border-color:var(--acc)}.cd.t{color:var(--acc);font-weight:800}.cd.u{background:none;color:var(--mute);font-weight:500}
.cd b{position:absolute;bottom:4px;width:5px;height:5px;border-radius:50%}
.stat{flex:1;background:var(--surf);border:1px solid var(--line);box-shadow:var(--sh);border-radius:20px;padding:14px 16px}.stat div{font-size:28px;font-weight:800;letter-spacing:-.8px}
.stat.hero{background:linear-gradient(135deg,var(--acc2),var(--acc));color:#fff;border:0}.stat.hero .mute{color:#ffffffcc}
.bars{display:flex;align-items:flex-end;gap:8px;height:96px}.bars i{flex:1;background:linear-gradient(var(--acc),var(--acc2));border-radius:8px;min-height:4px}
.toast{position:fixed;top:calc(env(safe-area-inset-top,0px) + 10px);left:50%;transform:translateX(-50%);background:var(--bad);color:#fff;padding:11px 18px;border-radius:99px;z-index:20;font-size:14px;font-weight:600;box-shadow:var(--sh)}
.empty{text-align:center;padding:44px 12px;color:var(--mute)}
.hero{display:flex;align-items:center;gap:18px;margin:14px 0 8px}
.ring{width:96px;height:96px;flex:none;position:relative}.ring svg{transform:rotate(-90deg)}.ring b{position:absolute;inset:0;display:grid;place-items:center;font-size:22px;font-weight:800}
.chip{display:inline-flex;align-items:center;gap:6px;background:var(--rest);padding:6px 12px;border-radius:99px;font-size:13px;font-weight:700}
.pill{display:inline-flex;align-items:center;gap:7px}
button{transition:transform .15s cubic-bezier(.3,.9,.3,1),background .25s,color .25s}button:active{transform:scale(.95)}
.chk{position:relative;display:grid;place-items:center}.chk.COMPLETED{animation:none}
.chk.fresh.COMPLETED{animation:pop .5s cubic-bezier(.34,1.56,.64,1)}
.chk.COMPLETED svg path{stroke-dasharray:26}.chk.fresh.COMPLETED svg path{animation:draw .4s .08s both}
.chk.fresh.COMPLETED::after{content:"";position:absolute;inset:-2px;border-radius:50%;border:2px solid var(--c);animation:burst .6s ease-out forwards}
@keyframes draw{from{stroke-dashoffset:26}to{stroke-dashoffset:0}}@keyframes burst{from{opacity:.7}to{transform:scale(1.7);opacity:0}}
@keyframes rise{from{opacity:0;transform:translateY(14px)}}
.enter>*{animation:rise .55s cubic-bezier(.2,.8,.2,1) both}.enter>*:nth-child(2){animation-delay:.04s}.enter>*:nth-child(3){animation-delay:.08s}.enter>*:nth-child(4){animation-delay:.12s}.enter>*:nth-child(5){animation-delay:.16s}.enter>*:nth-child(n+6){animation-delay:.2s}
.enter .bars i{transform-origin:bottom;animation:grow .7s cubic-bezier(.2,.9,.3,1) both}@keyframes grow{from{transform:scaleY(0)}}
.enter .bars i:nth-child(2){animation-delay:.04s}.enter .bars i:nth-child(3){animation-delay:.08s}.enter .bars i:nth-child(4){animation-delay:.12s}.enter .bars i:nth-child(5){animation-delay:.16s}.enter .bars i:nth-child(6){animation-delay:.2s}.enter .bars i:nth-child(7){animation-delay:.24s}.enter .bars i:nth-child(8){animation-delay:.28s}
.dock{box-shadow:0 22px 44px -10px rgba(25,25,80,.38),0 6px 14px rgba(25,25,60,.14),inset 0 1px 0 rgba(255,255,255,.45);border:1px solid color-mix(in srgb,var(--text) 7%,transparent)}
.dock button[aria-current="page"]{background:none}.dock button{position:relative;z-index:1}.dock button span{display:flex}
.dock .ind{position:absolute;top:6px;bottom:6px;left:6px;width:calc((100% - 12px)/5);border-radius:999px;background:color-mix(in srgb,var(--acc) 16%,transparent);box-shadow:inset 0 0 0 1px color-mix(in srgb,var(--acc) 20%,transparent);transform:translateX(calc(var(--i,0)*100%));transition:transform .5s cubic-bezier(.34,1.4,.5,1)}
.dockfade{position:fixed;left:0;right:0;bottom:0;height:calc(120px + env(safe-area-inset-bottom,0px));pointer-events:none;z-index:4;-webkit-backdrop-filter:blur(16px);backdrop-filter:blur(16px);-webkit-mask-image:linear-gradient(transparent,#000 65%);mask-image:linear-gradient(transparent,#000 65%);background:linear-gradient(transparent,color-mix(in srgb,var(--bg) 80%,transparent))}
.calcard{background:var(--surf);border-radius:30px;padding:20px 14px 18px;margin-top:16px;border:1px solid var(--line);box-shadow:0 28px 60px -22px rgba(40,40,120,.35),0 4px 10px rgba(20,20,50,.05)}
.nav{width:40px;height:40px;border-radius:50%;border:0;background:var(--surf);display:grid;place-items:center;box-shadow:0 6px 16px -2px rgba(25,25,70,.22),0 0 0 1px var(--line)}
.wk{color:var(--mute);font-size:11px;font-weight:700;letter-spacing:.08em;margin-bottom:10px}.days{row-gap:10px}
.cd{width:100%;max-width:44px;margin:auto;border:0;background:conic-gradient(var(--acc2) calc(var(--p)*1%),var(--rest) 0);aspect-ratio:1;border-radius:50%;display:grid;place-items:center;position:relative;padding:0;font-weight:600}
.cd::before{content:"";position:absolute;inset:3.5px;border-radius:50%;background:var(--surf)}.cd span{position:relative}
.cd.u{background:none;color:var(--mute);font-weight:500}.cd.u::before{display:none}
.cd.t span{color:var(--acc);font-weight:800}
.cd.sel{background:linear-gradient(135deg,var(--acc2),var(--acc));color:#fff;transform:scale(1.08);box-shadow:0 10px 20px -4px color-mix(in srgb,var(--acc) 65%,transparent)}.cd.sel::before{display:none}.cd.sel span{color:#fff}
.cd2{aspect-ratio:1;border:0;border-radius:12px;font-weight:600;font-size:13px;padding:0;min-height:36px}
@media (prefers-reduced-motion:reduce){*,*::before,*::after{animation:none!important;transition:none!important}}

/* ===== Translucent scroll nav (IG-style) ===== */
.dock{transition:transform .45s cubic-bezier(.2,.8,.2,1),background .35s,box-shadow .35s,opacity .35s;will-change:transform}
.dock.scrolling{background:color-mix(in srgb,var(--surf) 38%,transparent);-webkit-backdrop-filter:blur(26px) saturate(190%);backdrop-filter:blur(26px) saturate(190%);box-shadow:0 12px 30px -12px rgba(25,25,80,.22),inset 0 1px 0 rgba(255,255,255,.3)}
.dock.hide{transform:translateY(calc(100% + 28px));opacity:.0}
.dock button svg{transition:transform .45s cubic-bezier(.34,1.56,.64,1)}
.dock button[aria-current="page"] svg{transform:translateY(-1px) scale(1.12)}
.dock button.bump svg{animation:bump .5s cubic-bezier(.34,1.56,.64,1)}
@keyframes bump{40%{transform:translateY(-4px) scale(1.25)}}
.dockfade{transition:opacity .35s}.dockfade.hide{opacity:0}

/* ===== iOS-style sheet + settings ===== */
.ios-top{display:grid;grid-template-columns:1fr auto 1fr;align-items:center;margin:-2px 0 14px}
.ios-top b{font-size:17px;font-weight:700}.ios-top button{border:0;background:none;font-size:17px;color:var(--acc);padding:8px 0;min-height:40px}
.ios-top button:last-child{text-align:right;font-weight:700}.ios-top button:first-child{text-align:left}
.ios-prev{display:grid;place-items:center;margin:4px 0 16px}.ios-prev .ic{width:76px;height:76px;border-radius:24px;font-size:34px;transition:background .3s,color .3s}
.gl{font-size:13px;color:var(--mute);margin:20px 16px 7px;text-transform:uppercase;letter-spacing:.04em;font-weight:500}
.gf{font-size:13px;color:var(--mute);margin:7px 16px 0;line-height:1.35}
.grp{background:var(--surf);border-radius:18px;overflow:hidden;border:1px solid var(--line)}
.rw{display:flex;align-items:center;gap:12px;min-height:52px;padding:0 16px;position:relative}
.rw+.rw::before{content:"";position:absolute;top:0;left:16px;right:0;height:1px;background:var(--line)}
.rw>span:first-child{flex:none}.rw input,.rw select{border:0;background:none;min-height:50px;padding:0;border-radius:0;text-align:right;flex:1;box-shadow:none!important}
.rw input.l{text-align:left}.rw input[type=time],.rw input[type=date]{flex:none;width:auto;color:var(--acc);font-weight:600}
.rw .ico{width:30px;height:30px;border-radius:9px;display:grid;place-items:center;color:#fff;font-size:15px;flex:none}
.sg{display:flex;background:var(--rest);border-radius:11px;padding:3px;margin:10px 12px}
.sg button{flex:1;border:0;background:none;border-radius:9px;min-height:34px;font-size:14px;font-weight:600;color:var(--text);transition:background .25s,box-shadow .25s}
.sg button.on{background:var(--surf);box-shadow:0 2px 8px rgba(0,0,0,.14)}
.sw{width:51px;height:31px;border-radius:99px;border:0;background:color-mix(in srgb,var(--mute) 35%,transparent);position:relative;flex:none;transition:background .3s;padding:0;margin-left:auto}
.sw::after{content:"";position:absolute;top:2px;left:2px;width:27px;height:27px;border-radius:50%;background:#fff;box-shadow:0 3px 8px rgba(0,0,0,.25);transition:transform .35s cubic-bezier(.34,1.4,.5,1)}
.sw.on{background:#34c759}.sw.on::after{transform:translateX(20px)}.sw:active::after{width:33px}.sw.on:active::after{transform:translateX(14px)}
.pk{padding:12px 14px 14px;display:flex;gap:10px;flex-wrap:wrap}.pk .pill{width:44px;height:44px;padding:0;justify-content:center;border-radius:14px}
.pk .step{width:34px;height:34px;border:3px solid transparent;box-shadow:inset 0 0 0 2px var(--surf)}
.tgr{display:none}.tgr.show{display:flex}
.rem{overflow:hidden;max-height:0;transition:max-height .4s cubic-bezier(.2,.8,.2,1)}.rem.show{max-height:70px}
.nt{display:flex;gap:11px;align-items:center;margin:12px;padding:11px 13px;border-radius:18px;background:color-mix(in srgb,var(--surf) 60%,transparent);-webkit-backdrop-filter:blur(20px);backdrop-filter:blur(20px);border:1px solid var(--line);box-shadow:var(--sh)}
.nt .ap{width:38px;height:38px;border-radius:10px;background:linear-gradient(135deg,var(--acc2),var(--acc));display:grid;place-items:center;color:#fff;font-weight:800;flex:none}
.nt small{color:var(--mute);font-size:12px}.nt div div{font-size:14px;font-weight:600;line-height:1.25}

/* ===== Plan & Goals + 6-tab dock + Telegram-style motion ===== */
.dock{max-width:440px;touch-action:none;user-select:none;-webkit-user-select:none}
.dock .ind{width:calc((100% - 12px)/6);transition:transform .55s cubic-bezier(.3,1.35,.45,1),scale .3s,background .3s}
.dock .ind.move{animation:stretch .6s cubic-bezier(.3,1.3,.5,1)}
@keyframes stretch{30%{scale:1.5 .88}65%{scale:.96 1.04}}
.dock.hold .ind{scale:1.1 1.06;background:color-mix(in srgb,var(--acc) 26%,transparent)}
.dock.hold button[aria-current="page"] svg{transform:scale(.92)}
.dock button{font-size:9.5px}
@keyframes sr{from{opacity:0;transform:translateX(30px)}}@keyframes sl{from{opacity:0;transform:translateX(-30px)}}
.enter.dr>*{animation-name:sr}.enter.dl>*{animation-name:sl}
.wk7{display:grid;grid-template-columns:repeat(7,1fr);gap:6px;margin:14px 0 4px}
.dy{border:0;border-radius:18px;background:var(--surf);border:1px solid var(--line);min-height:68px;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:3px;padding:0;transition:background .3s,color .3s,transform .3s cubic-bezier(.34,1.56,.64,1)}
.dy small{font-size:11px;font-weight:700;color:var(--mute);letter-spacing:.04em}.dy b{font-size:18px;font-weight:700}
.dy i{width:5px;height:5px;border-radius:50%;background:transparent}.dy i.p{background:var(--warn)}.dy i.f{background:var(--acc2)}
.dy.sel{background:var(--acc);border-color:var(--acc);color:#fff;transform:translateY(-2px);box-shadow:0 12px 22px -10px var(--acc)}.dy.sel small{color:#ffffffcc}.dy.sel i.f,.dy.sel i.p{background:#fff}
.dy.t:not(.sel) b{color:var(--acc)}
.pr{padding:9px 16px;min-height:62px}.tm{width:62px;font-size:13px;font-weight:600;color:var(--mute);font-variant-numeric:tabular-nums}
