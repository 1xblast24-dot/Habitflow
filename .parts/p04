  <div class="gf" style="text-align:center">${steps} steps planned each week</div>`}
 // ---- Plan (day view)
 const sel=V.psel&&V.psel>=ws&&V.psel<=Engine.addDays(ws,6)?V.psel:t;
 const agg=k=>{const p=Engine.dayProgress(D.habits,k,t,D.logs);let tot=p.total,dn=p.done;R.forEach(r=>{if(rOn(r,k)){tot++;if(rFull(r,k))dn++}});return[tot,dn]};
 const strip=Array.from({length:7},(_,i)=>{const k=Engine.addDays(ws,i),[tot,dn]=agg(k);return`<button class="dy ${k===sel?'sel':''} ${k===t?'t':''}" data-act="psel" data-k="${k}"><small>${'SMTWTFS'[i]}</small><b>${+k.slice(8)}</b><i class="${tot&&dn===tot?'f':dn?'p':''}"></i></button>`}).join('');
