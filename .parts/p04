  return`<div class="grp rc"><div class="rw rh" data-act="redit" data-r="${r.id}" style="cursor:pointer"><div class="ic" style="background:${r.color}1f;color:${r.color}">${ico(r.icon)}</div><div class="sp"><div class="t">${esc(r.name)}</div><div class="mute" style="font-size:13px">${r.time||'Anytime'} · ${n} of ${tot}${st>1?' · '+st+' day streak':''}</div></div>${ringSm(tot?n/tot:0,r.color)}</div>
  ${r.steps.map(x=>{const d=dn.includes(x.id);return`<div class="rw st ${d?'dn':''}"><button class="chk ${d?'COMPLETED':''} ${V.fresh===r.id+x.id+sel?'fresh':''}" style="--c:${r.color}" data-act="rstep" data-r="${r.id}" data-s="${x.id}" data-k="${sel}" ${sel>t?'disabled':''} aria-label="${d?'Uncheck':'Check'} ${esc(x.t)}">${svg(CK,'',3.4,15)}</button><span class="sp" data-act="${sel>t?'':'rstep'}" data-r="${r.id}" data-s="${x.id}" data-k="${sel}">${esc(x.t)}</span></div>`}).join('')}</div>`};
 return head+`<div class="wk7">${strip}</div><div class="gl">${fmtDate(sel)}</div>
