const gProg=g=>{const t=todayK(),h=g.habit&&D.habits.find(x=>x.id===g.habit);if(!h)return g.done||0;let n=0;for(let k=g.start;k<=t;k=Engine.addDays(k,1))if(Engine.state(h,k,t,D.logs)==='COMPLETED')n++;return n};
const slot=h=>!h.reminder?3:h.reminder<'12:00'?0:h.reminder<'17:00'?1:2;

const seg=t=>`<div class="sg" style="margin:12px 0 0">${[['plan','Plan'],['week','Week'],['areas','Areas'],['goals','Goals']].map(([i,l])=>`<button class="${t===i?'on':''}" data-act="ptab" data-v="${i}">${l}</button>`).join('')}</div>`;
const CK='<path d="M5 12.5l4.5 4.5L19 7.5"/>';
const rDone=(r,k)=>((D.rlogs[r.id]||{})[k]||[]).filter(i=>r.steps.some(s=>s.id===i)).length;
const rOn=(r,k)=>r.status!=='archived'&&k>=r.start&&r.days.includes(Engine.parse(k).getDay());
const rFull=(r,k)=>r.steps.length>0&&rDone(r,k)>=r.steps.length;
function rStreak(r,t){let c=0,k=t;for(let i=0;i<400&&k>=r.start;i++,k=Engine.addDays(k,-1)){if(!r.days.includes(Engine.parse(k).getDay()))continue;if(rFull(r,k))c++;else if(k!==t)break}return c}
const ringSm=(p,c)=>{const C=2*Math.PI*14;return`<svg width="38" height="38" viewBox="0 0 38 38" style="transform:rotate(-90deg);flex:none"><circle cx="19" cy="19" r="14" fill="none" stroke="var(--rest)" stroke-width="4.5"/><circle cx="19" cy="19" r="14" fill="none" stroke="${c}" stroke-width="4.5" stroke-linecap="round" stroke-dasharray="${C}" stroke-dashoffset="${C*(1-p)}" style="transition:stroke-dashoffset .5s cubic-bezier(.3,.9,.3,1)"/></svg>`};
const PLUS='<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round"><path d="M12 5v14M5 12h14"/></svg>';
const TPL=[['Morning routine','leaf','07:00',[0,1,2,3,4,5,6],['Drink water','Stretch 5 min','Plan the day']],['Workout','dumbbell','17:30',[1,3,5],['Warm up','Main sets','Cool down']],['Evening wind-down','moon','21:30',[0,1,2,3,4,5,6],['Journal','Prepare tomorrow','Screens off']]];
function vPlan(){
 const t=todayK(),tab=V.ptab||'plan';if(tab==='goals')return vGoals();if(tab==='areas')return V.area?vArea(V.area):vAreas();
 const R=D.routines.filter(r=>r.status!=='archived'),dow=Engine.parse(t).getDay(),ws=Engine.addDays(t,-dow);
 const head=`<div class="row"><div class="sp"><div class="mute" style="font-weight:600">${tab==='plan'?'Your routine system':'Weekly template'}</div><h1>${tab==='plan'?'Plan':'Week'}</h1></div><button class="plus" data-act="rnew" aria-label="New routine">${PLUS}</button></div>${seg(tab)}`;
