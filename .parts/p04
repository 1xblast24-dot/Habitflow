  const sessions=R.reduce((n,r)=>n+r.days.length,0),steps=R.reduce((n,r)=>n+r.days.length*r.steps.length,0);
  let dn=0;for(let i=0;i<=dow;i++){const k=Engine.addDays(ws,i);R.forEach(r=>{if(rOn(r,k)&&rFull(r,k))dn++})}
