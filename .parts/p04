 if(h.type==='yesno')ctl=`<button class="chk ${s}${V.fresh===h.id+k?' fresh':''}" ${c} data-act="toggle" data-h="${h.id}" data-k="${k}" aria-label="${s==='COMPLETED'?'Mark not done':'Complete'} ${esc(h.name)}">${SYM[s]}</button>`;
 else ctl=`<button class="step" data-act="dec" data-h="${h.id}" data-k="${k}" aria-label="Decrease">−</button><button class="val" data-act="log" data-h="${h.id}" data-k="${k}" aria-label="Enter exact value">${v} / ${h.target}${unit(h)?' '+esc(unit(h)):''}</button><button class="step" data-act="inc" data-h="${h.id}" data-k="${k}" aria-label="Increase">+</button>`;
 return`<div class="item"><div class="ic" style="background:${h.color}1f;color:${h.color}">${ico(h.icon)}</div><div class="sp" data-act="log" data-h="${h.id}" data-k="${k}" style="cursor:pointer"><div>${esc(h.name)}</div><div class="mute">${s==='SKIPPED'?'Skipped':s==='PARTIAL'?'Partial':s==='MISSED'?'Not logged':s==='COMPLETED'?'Done':'To do'}</div></div>${ctl}</div>`;
