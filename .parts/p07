 return(a?'':'<h2>Now & next</h2>')+`${sec('Now',cur,o=>orow(o,o.t?'Happening now · until '+hm(end(o)):'Anytime today'))}${sec('Up next',nx,o=>orow(o,`Starts in <b data-cd="${at(o)}">${fmtCd(at(o)-Date.now())}</b>${o.i.sch.rem?' · reminder '+o.i.sch.rem+' min before':''}`))}${sec('Still open',late,o=>orow(o,'Was due at '+o.t))}<div class="gf">${dn} of ${O.length} scheduled activit${O.length===1?'y':'ies'} done today</div>`}
